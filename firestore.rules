rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidCompanyConfig(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200;
    }

    function isValidSector(data) {
      return data.id is string && isValidId(data.id)
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200;
    }

    function isValidBioLink(data) {
      return data.id is string && isValidId(data.id)
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200;
    }

    function isValidLead(data) {
      return data.id is string && isValidId(data.id)
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.phone is string && data.phone.size() > 0;
    }

    function isValidPixClick(data) {
      return data.id is string && isValidId(data.id)
        && data.linkId is string && isValidId(data.linkId);
    }

    function isValidLinkClick(data) {
      return data.id is string && isValidId(data.id)
        && data.linkId is string && isValidId(data.linkId);
    }

    // Company Configuration
    match /config/{configId} {
      allow read: if true;
      allow write: if isValidId(configId) && isValidCompanyConfig(incoming());
    }

    // WhatsApp Sectors
    match /sectors/{sectorId} {
      allow read: if true;
      allow create, update: if isValidId(sectorId) && isValidSector(incoming());
      allow delete: if isValidId(sectorId);
    }

    // Bio Links (Real-time synced)
    match /links/{linkId} {
      allow read: if true;
      allow create, update: if isValidId(linkId) && isValidBioLink(incoming());
      allow delete: if isValidId(linkId);
    }

    // Captured Leads
    match /leads/{leadId} {
      allow read: if true;
      allow create: if isValidId(leadId) && isValidLead(incoming());
      allow update, delete: if isValidId(leadId);
    }

    // Logged PIX payment clicks
    match /pixClicks/{clickId} {
      allow read: if true;
      allow create: if isValidId(clickId) && isValidPixClick(incoming());
      allow delete: if isValidId(clickId);
    }

    // Logged clicks on all bio links
    match /linkClicks/{clickId} {
      allow read: if true;
      allow create: if isValidId(clickId) && isValidLinkClick(incoming());
      allow delete: if isValidId(clickId);
    }
  }
}
